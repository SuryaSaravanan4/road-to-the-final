datasource db {
  provider  = "postgresql"
  // Pooled (PgBouncer) endpoint for app queries in serverless functions.
  url       = env("DATABASE_URL")
  // Direct, non-pooled endpoint for `prisma migrate deploy` at build time —
  // migrations need a real session (advisory locks) that PgBouncer's
  // transaction pooling breaks. Neon's Vercel integration sets both vars.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider = "prisma-client-js"
}

// Generic TTL cache for raw provider responses (standings, fixtures) and
// generated scenario snapshots, keyed by an arbitrary string.
model CacheEntry {
  key       String   @id
  payload   String
  fetchedAt DateTime @default(now())
}

// A screenshot-ingested competition. Unlike CacheEntry this is NOT
// re-fetchable from any upstream — it is user-confirmed ground truth, so it
// must live in a persistent database (see README's Vercel /tmp warning).
// The JSON columns hold the current confirmed canonical state; the full
// audit trail of how it got there lives in Ingestion rows.
model Competition {
  id         String      @id @default(cuid())
  name       String
  sport      String      @default("unknown")
  // Bracket shape only — who plays whom: SINGLE_ELIM | DOUBLE_ELIM |
  // ROUND_ROBIN | GROUPS_KNOCKOUT.
  format     String
  // How standing/advancement is determined — a separate axis from format.
  // Null means win/loss elimination (the only Phase 1 behavior). Reserved
  // for rating-based competitions (e.g. "ELO") so supporting them later is
  // a new value here, not a schema migration.
  ratingSystem String?
  // JSON: [{ id, name }] — stable generated team ids for this competition.
  teams      String
  // JSON: Fixture[] (src/types/domain.ts shape).
  fixtures   String
  // JSON: Standing[] — only populated for formats with a table component.
  standings  String
  // JSON: string[] — the competition's real round order, first to last.
  stageOrder String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  ingestions Ingestion[]
}

// A human verdict on one Claude-assessed scenario (ADR 0002). Unlike an
// extraction correction there is no ground truth to diff against — a difficulty
// assessment is a judgment, and the live scenario is regenerated every cache
// TTL and never persisted. So this row SNAPSHOTS the assessment as it was
// shown (the "raw" side) next to the verdict (the "corrected" side); the report
// it feeds yields an agreement rate, not an error rate.
model ScenarioFeedback {
  id            String   @id @default(cuid())
  // Identity of the scenario slot at feedback time.
  providerKey   String
  teamId        String
  stage         String
  opponentId    String
  opponentName  String
  // The assessment exactly as shown — frozen, since the live one is gone.
  source        String // "model" | "bracket" (ScenarioSource)
  difficulty    String // easy | medium | hard, as shown
  likelihood    Int // 0-100, as shown
  reasoning     String // verbatim
  model         String? // ANTHROPIC_MODEL that produced it
  promptVersion String? // SCENARIO_PROMPT_VERSION at feedback time
  // The human verdict.
  verdict              String // "agree" | "disagree"
  difficultyCorrection String? // easy | medium | hard, only if the user reset it
  note                 String? // optional free text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Single-tenant, last-write-wins per scenario slot: Phase 1 has no user
  // model, so this is one opinion per scenario, not one per user. With Phase 2
  // accounts the key gains userId and the history becomes worth keeping.
  @@unique([providerKey, teamId, stage, opponentId])
}

// One screenshot upload: the source image, exactly what Claude extracted
// (with per-field confidences), the user's corrections, and the diff that
// was applied to the Competition on confirm — kept together so bad
// extractions can be debugged after the fact.
model Ingestion {
  id             String       @id @default(cuid())
  // Set at upload time when re-ingesting into an existing competition;
  // otherwise null until the draft is confirmed into a new one.
  competitionId  String?
  competition    Competition? @relation(fields: [competitionId], references: [id])
  imageData      String // base64
  imageMediaType String
  // JSON: the schema-validated extraction exactly as Claude returned it.
  rawExtraction  String
  // JSON: field-level user edits made in the confirmation preview.
  corrections    String?
  // JSON: the diff applied to the competition's confirmed state on confirm.
  appliedDiff    String?
  // DRAFT | CONFIRMED | DISCARDED
  status         String       @default("DRAFT")
  // Free-text reason captured when a DRAFT is discarded — the negative signal
  // "this extraction was too wrong to be worth fixing". Null unless DISCARDED.
  discardReason  String?
  createdAt      DateTime     @default(now())
  confirmedAt    DateTime?
  discardedAt    DateTime?
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Generic TTL cache for raw provider responses (standings, fixtures) and
// generated scenario snapshots, keyed by an arbitrary string.
model CacheEntry {
  key       String   @id
  payload   String
  fetchedAt DateTime @default(now())
}

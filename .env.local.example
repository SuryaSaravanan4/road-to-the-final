# Copy this file to .env.local and fill in the values.

# SQLite database file used by Prisma to cache fetched sports data.
DATABASE_URL="file:./dev.db"

# football-data.org API key (free tier) — used for ground-truth fixtures/standings.
# Get one at https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# Anthropic API key — used ONLY for reasoning over already-fetched data to
# produce the ranked scenario list. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: override the Claude model used for scenario reasoning.
ANTHROPIC_MODEL=claude-sonnet-5

# Which provider + team this instance tracks.
TRACKED_PROVIDER_KEY=soccer/world-cup-2026
TRACKED_TEAM_ID=
TRACKED_TEAM_NAME="United States"

# Optional: shared secret required by the /api/cron endpoint (Authorization: Bearer <secret>).
CRON_SECRET=

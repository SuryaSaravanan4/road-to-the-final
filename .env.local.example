# Copy this file to .env.local and fill in the values.

# Postgres (Neon) connection strings.
#  - DATABASE_URL: pooled (PgBouncer) endpoint, used by the app at runtime.
#    Keep the pgbouncer=true param; connection_limit is per serverless instance.
#  - DATABASE_URL_UNPOOLED: direct (non-pooled) endpoint, used ONLY by
#    `prisma migrate deploy` / `prisma migrate dev` (migrations need a real
#    session for advisory locks, which transaction pooling breaks).
# On Vercel, both are provisioned automatically by the Neon integration.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# football-data.org API key (free tier) — used for ground-truth fixtures/standings.
# Get one at https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# Anthropic API key — used ONLY for reasoning over already-fetched data to
# produce the ranked scenario list. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: override the Claude model used for scenario reasoning.
ANTHROPIC_MODEL=claude-sonnet-5

# Which provider + team this instance tracks.
TRACKED_PROVIDER_KEY=soccer/world-cup-2026
TRACKED_TEAM_ID=
TRACKED_TEAM_NAME="United States"

# Optional: shared secret required by the /api/cron endpoint (Authorization: Bearer <secret>).
CRON_SECRET=
